{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "rootDir": "../..",
    "declarationDir": "dist/types"
  },
  "include": ["src", "../../src/vite-env.d.ts"]
}
