{
  "name": "big-city-greens-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,dashboard,browser,electron -c green,cyan,blue,magenta \"npm run dev:server\" \"npm run dev:dashboard\" \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electronmon .\"",
    "dev:server": "npm --prefix server run dev",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "build": "tsc -b && vite build",
    "build:dashboard": "tsc -p dashboard && vite build --config dashboard/vite.config.ts",
    "start": "electron .",
    "start:server": "npm run build:dashboard && npm --prefix server start",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.example.bigcitygreensbrowser",
    "productName": "Big City Greens Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education"
    },
    "dmg": {
      "artifactName": "Wonderly-mac-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Wonderly-windows-setup.${ext}"
    },
    "appImage": {
      "artifactName": "Wonderly-linux.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "electronmon": {
    "patterns": [
      "!src/**",
      "!dist/**",
      "!public/**",
      "!index.html",
      "!vite.config.ts",
      "!server/**",
      "!dashboard/**"
    ]
  }
}
